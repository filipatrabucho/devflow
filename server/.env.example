# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Supabase project (Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

# Postgres connection string (Supabase Settings > Database > Connection string, "URI" tab)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Bootstrap account created by `npm run db:init` if the profiles table is empty
BOOTSTRAP_SENIOR_NAME=Admin
BOOTSTRAP_SENIOR_EMAIL=admin@example.com
BOOTSTRAP_SENIOR_PASSWORD=change-me-now-123
