# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_NAME=devflow_token

# Only email addresses ending with this domain may sign in / be created
ALLOWED_EMAIL_DOMAIN=@pkf.pt

# MariaDB / MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=devflow
DB_PASSWORD=change-me
DB_NAME=devflow

# Bootstrap account created by `npm run db:init` if the users table is empty
BOOTSTRAP_SENIOR_NAME=Admin
BOOTSTRAP_SENIOR_EMAIL=admin@pkf.pt
BOOTSTRAP_SENIOR_PASSWORD=change-me-now-123
