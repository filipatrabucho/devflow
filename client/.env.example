# Supabase project (Settings > API) - the anon key is safe to expose to the browser
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=change-me

# White-label branding (all optional — each falls back to the DevFlow default
# below if unset, so nothing needs to change for the original instance).
# IMPORTANT: quote hex colors ("#552f86") in .env files — an unquoted `#`
# starts a comment, silently truncating the value. Netlify's own env var
# dashboard doesn't have this issue (it's a single text field, not a parsed
# .env file), but keep the quotes if you ever set these in a local .env too.
# VITE_APP_NAME=DevFlow
# VITE_APP_TAGLINE=Task management for engineering teams
# VITE_PRIMARY_COLOR="#552f86"
# VITE_PRIMARY_HOVER_COLOR="#40166d"
# VITE_PRIMARY_LIGHT_COLOR="#9769dc"
# VITE_LOGO_URL=https://example.com/client-logo.svg
# VITE_FAVICON_URL=https://example.com/client-favicon.svg
